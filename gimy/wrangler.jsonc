{
  "name": "gimy-tv",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "WATCH_HISTORY", "class_name": "WatchHistory" }] },
  "migrations": [{ "tag": "gimy-history-v1", "new_sqlite_classes": ["WatchHistory"] }],
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "GIMY_MEDIA_HOSTS": "" },
  "observability": { "enabled": true }
}
