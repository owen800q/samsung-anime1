<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/owen800q/Samsung-anime1" version="1.0.0" viewmodes="maximized">
    <tizen:application id="Anime1TV01.Anime1TV" package="Anime1TV01" required_version="4.0"/>
    <name>Anime1 TV</name>
    <description>Anime1 動畫目錄電視版：瀏覽、搜尋、彈幕播放、雲端觀看紀錄與手機遙控，全程遙控器操作。</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <author>samsung-anime1 contributors</author>

    <!-- The app calls the samsung-anime1 Worker (API and media) and Bangumi covers through it. -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'self' data: blob: 'unsafe-inline'; img-src * data: blob:; media-src * blob: data:; connect-src * ws: wss:;</tizen:content-security-policy>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:profile name="tv-samsung"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
