{
  "name": "samsung-anime1",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": { "DANDANPLAY_APP_ID": "dfgi5f83qb" },
  "durable_objects": { "bindings": [{ "name": "WATCH_HISTORY", "class_name": "WatchHistory" }] },
  "migrations": [{ "tag": "watch-history-v1", "new_sqlite_classes": ["WatchHistory"] }],
  "build": { "command": "node scripts/build.mjs && npm run build:tv-update" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
